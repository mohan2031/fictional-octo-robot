{
  "entities": {
    "inquiry": {
      "title": "Inquiry",
      "description": "A patient inquiry sent to a clinic owner.",
      "type": "object",
      "properties": {
        "clinicId": {
          "type": "string",
          "description": "The ID of the clinic the inquiry is for."
        },
        "name": {
          "type": "string",
          "description": "Name of the person making the inquiry."
        },
        "contact": {
          "type": "string",
          "description": "Contact information (phone or email)."
        },
        "message": {
          "type": "string",
          "description": "The content of the inquiry message."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "The timestamp when the inquiry was created."
        },
        "isRead": {
            "type": "boolean",
            "description": "Whether the clinic owner has read the inquiry."
        }
      },
      "required": ["clinicId", "name", "contact", "message", "createdAt"]
    },
    "clinic": {
        "title": "Clinic",
        "description": "Represents a local clinic or healthcare provider.",
        "type": "object",
        "properties": {
            "name": { "type": "string" },
            "category": { "type": "string" },
            "ownerId": { "type": "string", "description": "The UID of the user who owns this clinic." },
            "description": { "type": "string" },
            "location": { "type": "string" },
            "lat": { "type": "number", "description": "The latitude of the clinic's location." },
            "lng": { "type": "number", "description": "The longitude of the clinic's location." },
            "phone": { "type": "string" },
            "hours": { "type": "string" },
            "isOpen": { "type": "boolean" },
            "imageUrl": { "type": "string", "format": "uri" },
            "imageHint": { "type": "string" },
            "createdAt": { "type": "string", "format": "date-time" }
        }
    },
    "appointment": {
        "title": "Appointment",
        "description": "A scheduled appointment at a clinic.",
        "type": "object",
        "properties": {
            "clinicId": { "type": "string" },
            "userId": { "type": "string", "description": "The UID of the user who booked the appointment."},
            "patientName": { "type": "string" },
            "appointmentDate": { "type": "string", "format": "date-time" },
            "reason": { "type": "string" },
            "status": { "type": "string", "enum": ["scheduled", "completed", "cancelled"] },
            "createdAt": { "type": "string", "format": "date-time" }
        },
        "required": ["clinicId", "userId", "patientName", "appointmentDate", "reason", "status", "createdAt"]
    },
    "product": {
      "title": "Product",
      "description": "A product or service sold by a shop.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "isAvailable": { "type": "boolean" },
        "imageUrl": { "type": "string", "format": "uri" },
        "imageHint": { "type": "string" }
      }
    },
    "shop": {
        "title": "Shop",
        "description": "Represents a local shop or business.",
        "type": "object",
        "properties": {
            "name": { "type": "string" },
            "category": { "type": "string" },
            "ownerId": { "type": "string" },
            "description": { "type": "string" },
            "location": { "type": "string" },
            "lat": { "type": "number" },
            "lng": { "type": "number" },
            "phone": { "type": "string" },
            "hours": { "type": "string" },
            "isOpen": { "type": "boolean" },
            "imageUrl": { "type": "string", "format": "uri" },
            "imageHint": { "type": "string" },
            "createdAt": { "type": "string", "format": "date-time" },
            "products": {
                "type": "array",
                "items": { "$ref": "#/backend/entities/product" }
            }
        }
    },
    "shopInquiry": {
      "title": "Shop Inquiry",
      "description": "A customer inquiry sent to a shop owner.",
      "type": "object",
      "properties": {
        "shopId": { "type": "string" },
        "userId": { "type": "string", "description": "The UID of the user who sent the inquiry, if they were logged in." },
        "name": { "type": "string" },
        "contact": { "type": "string" },
        "message": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time"},
        "isRead": { "type": "boolean" }
      },
      "required": ["shopId", "name", "contact", "message", "createdAt"]
    },
    "userProfile": {
      "title": "User Profile",
      "description": "Represents a user's profile information.",
      "type": "object",
      "properties": {
        "displayName": {
          "type": "string",
          "description": "The user's display name."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "The user's email address."
        },
        "role": {
          "type": "string",
          "description": "The user's role in the application.",
          "enum": ["customer", "owner"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "The timestamp when the user profile was created."
        }
      },
      "required": ["displayName", "email", "role", "createdAt"]
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/inquiries/{inquiryId}": {
      "schema": {
        "$ref": "#/backend/entities/inquiry"
      },
      "description": "Stores patient inquiries for clinics."
    },
    "/clinics/{clinicId}": {
        "schema": {
            "$ref": "#/backend/entities/clinic"
        },
        "description": "Stores information about each clinic."
    },
    "/appointments/{appointmentId}": {
        "schema": {
            "$ref": "#/backend/entities/appointment"
        },
        "description": "Stores patient appointments for clinics."
    },
    "/shops/{shopId}": {
      "schema": { "$ref": "#/backend/entities/shop" },
      "description": "Stores information about each shop."
    },
    "/shop-inquiries/{inquiryId}": {
        "schema": { "$ref": "#/backend/entities/shopInquiry" },
        "description": "Stores customer inquiries for shops."
    },
    "/users/{userId}": {
      "schema": {
        "$ref": "#/backend/entities/userProfile"
      },
      "description": "Stores user profile information, linked to Firebase Auth UID."
    }
  }
}
