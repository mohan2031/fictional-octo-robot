rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =====================================================================
    // Helper Functions for Schema Validation
    // =====================================================================

    function isUserProfile(data) {
      return data.displayName is string && data.displayName.size() > 1
          && data.email is string && data.email.matches('.*@.*')
          && data.role is string && (data.role == 'customer' || data.role == 'owner')
          && (
            (request.method == 'create' && data.createdAt == request.time) ||
            (request.method == 'update' && data.createdAt is timestamp)
          );
    }

    function isClinic(data) {
        return data.name is string && data.name.size() > 1
          && data.category is string
          && data.ownerId is string
          && data.description is string
          && data.location is string
          && data.lat is number
          && data.lng is number
          && data.phone is string
          && data.hours is string
          && data.isOpen is bool
          && data.imageUrl is string
          && data.imageHint is string
          && (
            (request.method == 'create' && data.createdAt == request.time) ||
            (request.method == 'update' && data.createdAt is timestamp)
          );
    }

    function isProduct(data) {
        return data.id is string
            && data.name is string && data.name.size() > 1
            && data.description is string && data.description.size() > 9
            && data.isAvailable is bool
            && data.imageUrl is string
            && data.imageHint is string;
    }

    function isShop(data) {
        return data.name is string && data.name.size() > 1
          && data.category is string
          && data.ownerId is string
          && data.description is string
          && data.location is string
          && data.lat is number
          && data.lng is number
          && data.phone is string
          && data.hours is string
          && data.isOpen is bool
          && data.imageUrl is string
          && data.imageHint is string
          && (
            (request.method == 'create' && data.createdAt == request.time) ||
            (request.method == 'update' && data.createdAt is timestamp)
          );
    }
    
    function isAppointment(data) {
      return data.clinicId is string
          && data.userId is string
          && data.patientName is string && data.patientName.size() > 1
          && data.appointmentDate is timestamp
          && data.reason is string && data.reason.size() > 9
          && data.status is string && (data.status == 'scheduled' || data.status == 'completed' || data.status == 'cancelled')
          && (
            (request.method == 'create' && data.createdAt == request.time) ||
            (request.method == 'update' && data.createdAt is timestamp)
          );
    }
    
    function isInquiry(data) {
        return data.clinicId is string
            && (!('userId' in data) || data.userId is string)
            && data.name is string && data.name.size() > 1
            && data.contact is string && data.contact.size() > 4
            && data.message is string && data.message.size() > 9
            && data.createdAt == request.time
            && data.isRead == false;
    }
    
    function isShopInquiry(data) {
        return data.shopId is string
            && (!('userId' in data) || data.userId is string)
            && data.name is string && data.name.size() > 1
            && data.contact is string && data.contact.size() > 4
            && data.message is string && data.message.size() > 9
            && data.createdAt == request.time
            && data.isRead == false;
    }

    function isReview(data) {
      return data.businessId is string
          && data.businessType is string && (data.businessType == 'clinic' || data.businessType == 'shop')
          && data.userId is string
          && data.authorName is string
          && data.rating is number && data.rating >= 1 && data.rating <= 5
          && data.comment is string && data.comment.size() > 9
          && (
            (request.method == 'create' && data.createdAt == request.time) ||
            (request.method == 'update' && data.createdAt is timestamp)
          );
    }
    
    // =====================================================================
    // Collection Rules
    // =====================================================================

    match /inquiries/{inquiryId} {
      // Anyone can submit an inquiry, but if logged in, userId must match.
      allow create: if (request.auth == null || request.resource.data.userId == request.auth.uid) 
                    && isInquiry(request.resource.data);
      // Clinic owner OR user who sent it can read.
      allow read: if request.auth.uid != null && (
                    get(/databases/$(database)/documents/clinics/$(resource.data.clinicId)).data.ownerId == request.auth.uid || 
                    resource.data.userId == request.auth.uid
                  );
      allow update: if request.auth.uid != null 
                    && get(/databases/$(database)/documents/clinics/$(resource.data.clinicId)).data.ownerId == request.auth.uid
                    && request.resource.data.isRead == true
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
    }

    match /clinics/{clinicId} {
      allow read: if true;
      allow create: if request.auth.uid != null 
                    && request.auth.uid == request.resource.data.ownerId
                    && isClinic(request.resource.data);
      allow update: if request.auth.uid != null 
                    && request.auth.uid == resource.data.ownerId
                    && isClinic(request.resource.data);
    }

    match /appointments/{appointmentId} {
      allow create: if request.auth.uid != null 
                    && request.auth.uid == request.resource.data.userId
                    && isAppointment(request.resource.data);
      allow read: if request.auth.uid != null && (request.auth.uid == resource.data.userId || get(/databases/$(database)/documents/clinics/$(resource.data.clinicId)).data.ownerId == request.auth.uid);
      allow update: if request.auth.uid != null && (
            ( // User can cancel their own appointment
              request.auth.uid == resource.data.userId &&
              request.resource.data.status == 'cancelled' &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
            ) || ( // Owner can update the status
              get(/databases/$(database)/documents/clinics/$(resource.data.clinicId)).data.ownerId == request.auth.uid &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
            )
          );
      allow delete: if request.auth.uid != null && request.auth.uid == resource.data.userId;
    }

    match /shops/{shopId} {
      allow read: if true;
      allow create: if request.auth.uid != null 
                    && request.auth.uid == request.resource.data.ownerId
                    && isShop(request.resource.data);
      allow update: if request.auth.uid != null 
                    && request.auth.uid == resource.data.ownerId
                    && isShop(request.resource.data);

      match /products/{productId} {
        allow read: if true;
        allow create: if request.auth.uid != null
                      && get(/databases/$(database)/documents/shops/$(shopId)).data.ownerId == request.auth.uid
                      && isProduct(request.resource.data);
        allow update: if request.auth.uid != null
                      && get(/databases/$(database)/documents/shops/$(shopId)).data.ownerId == request.auth.uid
                      && isProduct(request.resource.data);
        allow delete: if request.auth.uid != null
                      && get(/databases/$(database)/documents/shops/$(shopId)).data.ownerId == request.auth.uid;
      }
    }

    match /shop-inquiries/{inquiryId} {
      allow create: if (request.auth == null || request.resource.data.userId == request.auth.uid)
                    && isShopInquiry(request.resource.data);
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || get(/databases/$(database)/documents/shops/$(resource.data.shopId)).data.ownerId == request.auth.uid);
      allow update: if request.auth != null 
                    && get(/databases/$(database)/documents/shops/$(resource.data.shopId)).data.ownerId == request.auth.uid
                    && request.resource.data.isRead == true
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
    }

    match /users/{userId} {
      allow create, update: if request.auth.uid == userId && isUserProfile(request.resource.data);
      allow read: if request.auth.uid == userId;
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.auth != null 
                    && request.auth.uid == request.resource.data.userId
                    && isReview(request.resource.data);
      allow update, delete: if request.auth != null 
                          && request.auth.uid == resource.data.userId
                          && isReview(request.resource.data);
    }
  }
}
