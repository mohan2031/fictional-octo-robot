rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Allow anyone to submit an inquiry
    match /inquiries/{inquiryId} {
      allow create: if true;
      // For now, allow anyone to read.
      // In a real app, you should restrict this to the authenticated shop owner.
      // e.g., allow read: if get(/databases/$(database)/documents/shops/$(resource.data.shopId)).data.ownerId == request.auth.uid;
      allow read, update: if true;
    }

    // You can add rules for other collections here.
    // For example, to secure a 'shops' collection:
    // match /shops/{shopId} {
    //   allow read: if true;
    //   allow write: if resource.data.ownerId == request.auth.uid;
    // }
  }
}
