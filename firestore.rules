rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /inquiries/{inquiryId} {
      // Anyone can submit an inquiry to a clinic
      allow create: if true;
      // Only the clinic owner can read or update their inquiries
      allow read, update: if request.auth.uid != null && get(/databases/$(database)/documents/clinics/$(resource.data.clinicId)).data.ownerId == request.auth.uid;
    }

    match /clinics/{clinicId} {
      // Anyone can view a clinic
      allow read: if true;
      // A logged-in user can create a clinic if they are the owner
      allow create: if request.auth.uid != null && request.auth.uid == request.resource.data.ownerId;
      // Only the owner can update their clinic details
      allow update: if request.auth.uid != null && request.auth.uid == resource.data.ownerId;
    }

    match /appointments/{appointmentId} {
      // A logged in user can create an appointment for themselves
      allow create: if request.auth.uid != null && request.auth.uid == request.resource.data.userId;
      // The user who booked can view/cancel. The clinic owner can view/update.
      allow read: if request.auth.uid != null && (request.auth.uid == resource.data.userId || get(/databases/$(database)/documents/clinics/$(resource.data.clinicId)).data.ownerId == request.auth.uid);
      allow update: if request.auth.uid != null && (request.auth.uid == resource.data.userId || get(/databases/$(database)/documents/clinics/$(resource.data.clinicId)).data.ownerId == request.auth.uid);
      // Only the user who booked can delete their appointment.
      allow delete: if request.auth.uid != null && request.auth.uid == resource.data.userId;
    }

    match /shops/{shopId} {
      // Anyone can view a shop
      allow read: if true;
      // A logged-in user can create a shop if they are the owner
      allow create: if request.auth.uid != null && request.auth.uid == request.resource.data.ownerId;
      // Only the owner can update their shop details
      allow update: if request.auth.uid != null && request.auth.uid == resource.data.ownerId;
    }

    match /shop-inquiries/{inquiryId} {
      // Anyone can submit an inquiry to a shop. If logged in, the userId must match their auth uid.
      allow create: if request.auth == null || request.resource.data.userId == request.auth.uid;
      // The user who sent the inquiry can read it, as can the shop owner.
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || get(/databases/$(database)/documents/shops/$(resource.data.shopId)).data.ownerId == request.auth.uid);
      // Only the shop owner can update (e.g. mark as read).
      allow update: if request.auth != null && get(/databases/$(database)/documents/shops/$(resource.data.shopId)).data.ownerId == request.auth.uid;
    }

    match /users/{userId} {
      // A user can create their own profile, and can only read/write their own data.
      allow create, read, update: if request.auth.uid == userId;
    }

    match /reviews/{reviewId} {
      // Anyone can read reviews
      allow read: if true;
      // An authenticated user can create a review if they are the author
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      // The author can update or delete their own review
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }
  }
}
