rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /inquiries/{inquiryId} {
      // Anyone can submit an inquiry
      allow create: if true;
      // Only the shop owner can read or update their inquiries
      allow read, update: if request.auth.uid != null && get(/databases/$(database)/documents/shops/$(resource.data.shopId)).data.ownerId == request.auth.uid;
    }

    match /shops/{shopId} {
      // Anyone can view a shop
      allow read: if true;
      // A logged-in user can create a shop if they are the owner
      allow create: if request.auth.uid != null && request.auth.uid == request.resource.data.ownerId;
      // Only the owner can update their shop details
      allow update: if request.auth.uid != null && request.auth.uid == resource.data.ownerId;
    }
  }
}
